# Copiez ce fichier en .env pour docker compose. Ne commitez jamais le vrai .env.
MYSQL_ROOT_PASSWORD=change-moi-root
DB_PASSWORD=change-moi-app
# Générez des secrets longs, par exemple : openssl rand -base64 48
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire
QR_SECRET=remplacez-par-une-autre-longue-chaine-aleatoire
# true pour créer les comptes et départs de démonstration au premier démarrage
DEMO_DATA=true
